        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var terminalStatuses = ['completed', 'partial_success', 'completed_with_error', 'failed'];
    var currentStatus = current.getValue('job_status');

    if (terminalStatuses.indexOf(currentStatus) === -1) {
        return;
    }

    var configSysId = current.getValue('illumio_pce_configuration');
    if (gs.nil(configSysId)) {
        gs.error('[Illumio Trigger Post Sync Discovery] No PCE configuration found on sync job ' + current.getUniqueValue());
        return;
    }

    gs.info('[Illumio Trigger Post Sync Discovery] Sync job ' + current.getUniqueValue() +
        ' completed with status ' + currentStatus + '. Triggering post-sync discovery for config ' + configSysId);

    var when = new GlideDateTime();
    gs.eventQueueScheduled('x_illu2_illumio.post_sync_discovery', current, configSysId, '', when);

})(current, previous);
]]></script>
