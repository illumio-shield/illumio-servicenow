        <name>Set Sync Filter Group Qualifier</name>
        <order/>
        <script><![CDATA[function onLoad() {
    setGroupQualifier();
}

function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) return;
    setGroupQualifier();
    g_form.setValue('sync_filter_group', '');
}

function setGroupQualifier() {
    var syncFilterId = g_form.getValue('illumio_sync_filter');
    if (syncFilterId) {
        g_form.setRefQualifier('sync_filter_group', 'sync_filter=' + syncFilterId);
    }
}
]]></script>
