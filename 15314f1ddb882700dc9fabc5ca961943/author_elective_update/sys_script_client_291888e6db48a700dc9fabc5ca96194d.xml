        <condition/>
        <description>Set value selected in 'select_application' in hidden field 'hide_application' </description>
        <field>select_application</field>
        <global>true</global>
        <isolate_script>false</isolate_script>
        <messages/>
        <name>Illumio OnChange Application Label</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
	if (isLoading || newValue === '') {
		return;
	}

	// set value of hidden application field to current value
	g_form.setValue('hide_application',newValue);

}]]></script>
